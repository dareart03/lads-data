{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "One non-wish-pool event in events.json (the merged, published file).",
  "type": "object",
  "additionalProperties": false,
  "required": ["page", "name", "kind", "startDate", "endDate", "featured", "status"],
  "properties": {
    "page": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "minLength": 1, "description": "Slug of the wiki type, e.g. 'login', 'promise-rerun'" },
    "wikiType": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "series": { "type": "string" },
    "featured": { "type": "boolean" },
    "startDate": { "$ref": "#/$defs/dateOrEmpty" },
    "endDate": { "$ref": "#/$defs/dateOrEmpty" },
    "timeReference": { "type": "string" },
    "status": { "enum": ["announced", "confirmed"] },
    "relatedCharacters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedMemories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
  },
  "$defs": {
    "dateOrEmpty": {
      "type": "string",
      "pattern": "^(\\d{4}-\\d\\d-\\d\\d \\d\\d:\\d\\d:\\d\\d)?$"
    }
  }
}
